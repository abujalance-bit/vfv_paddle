# Supabase > Project Settings > API Keys (o Data API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Publishable key (sb_publishable_...) o la antigua "anon" key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) o la antigua "service_role" key. ¡Nunca la compartas!
SUPABASE_SECRET_KEY=

# Dominio ficticio para los emails internos de los usuarios (no se envían correos)
NEXT_PUBLIC_LOGIN_DOMAIN=equipos.vfvpadel.app

# URL pública de la web, para la vista previa al compartir el enlace (en Vercel se deduce sola)
# NEXT_PUBLIC_SITE_URL=https://equipos.vfvpadel.app
